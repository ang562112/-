# ==============================
# Global mode flags
# ==============================
APP_ENV=development
REPORT_PROVIDER_MODE=mock # mock | production
MAX_FRESHNESS_SECONDS=120

# ==============================
# apps/web (Vercel)
# ==============================
# Used when REPORT_PROVIDER_MODE=production
REPORT_API_URL=https://your-report-worker.example.com
REPORT_API_TOKEN=replace-me

# Optional: show environment badge on UI
NEXT_PUBLIC_APP_NAME=LLM Multifactor Read-only Dashboard
NEXT_PUBLIC_APP_ENV=development

# ==============================
# External runtime services (Railway/Fly/Render etc.)
# ==============================
# ingestion / signal-engine / risk-engine / report-worker
POSTGRES_URL=postgres://user:pass@host:5432/db
REDIS_URL=redis://localhost:6379
EVENT_QUEUE_URL=redis://localhost:6379/1

# Upstream market and intelligence providers (examples)
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
NEWS_API_KEY=
ONCHAIN_API_KEY=
MACRO_DATA_API_KEY=

# Cron / scheduler (external runtime only, NOT vercel functions)
CRON_ENABLED=true
CRON_TZ=UTC
